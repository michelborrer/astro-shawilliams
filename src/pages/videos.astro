---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroFlight from '../assets/images/videos-hero-leadership-flight.jpg';
import { videos, videoCategories } from '../data/videos';

const title = 'Videos — Sharon Williams Psychologist';
const description =
  'Short video lessons on leadership, performance and decision-making from Sharon Williams: Leadership Strategy & Performance and Leadership Lessons from the Cockpit.';
---

<Layout title={title} description={description} path="/videos">
  <section class="relative">
    <Image
      src={heroFlight}
      alt="Leadership in Flight Programme"
      class="w-full h-[60vh] md:h-[70vh] object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/20 to-neutral-950/80"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 pb-12 md:pb-16 w-full">
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl tracking-tight max-w-4xl">
          Shorts from Sharon
        </h1>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl">
          Leadership insights on strategy, performance, and the psychology of exceptional executives.
        </p>
      </div>
    </div>
  </section>

  {videoCategories.map((category) => {
    const items = videos.filter((v) => v.category === category);
    return (
      <section class="bg-neutral-950 py-20 border-b border-neutral-900 last:border-b-0">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="font-serif text-2xl md:text-3xl mb-10 text-white">{category}</h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {items.map((video) => (
              <article class="bg-neutral-900 border border-neutral-800 hover:border-amber-500 transition-colors flex flex-col">
                <a href={`/videos/${video.slug}`} class="block aspect-video overflow-hidden motion-safe-hover-scale focus-ring">
                  <img
                    src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500"
                  />
                </a>
                <div class="p-6 flex-1 flex flex-col gap-4">
                  <h3 class="font-serif text-xl flex-1">
                    <a href={`/videos/${video.slug}`} class="hover:text-white focus-ring rounded-sm">
                      {video.title}
                    </a>
                  </h3>
                  <a
                    href={`/videos/${video.slug}`}
                    class="text-white text-sm tracking-widest uppercase self-start focus-ring rounded-sm"
                  >
                    Watch video &rarr;
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-neutral-900 py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-neutral-300 mb-6">
        Ready to go deeper? Sharon's coaching programs use clinical-grade assessment to uncover the
        derailers these videos describe.
      </p>
      <a
        href="/coaching"
        class="inline-block bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-8 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
      >
        Explore coaching
      </a>
    </div>
  </section>
</Layout>
