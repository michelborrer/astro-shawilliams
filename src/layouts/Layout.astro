---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import footerAccent from '../assets/images/footer-red.png';
import { CALENDLY_URL } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sharon Williams | Psychologist & Trusted Advisor for CEOs and C-Suite Executives',
  description = "Registered psychologist and executive coach with over 20 years' experience working with CEOs and C-suite leaders to overcome self-sabotage, build resilience and drive lasting performance.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans antialiased">
    <header class="sticky top-0 z-50 bg-neutral-950/90 backdrop-blur border-b border-neutral-800">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        <a href="/" class="flex items-center shrink-0">
          <Image src={logo} alt="Sharon Williams" class="h-12 w-auto" loading="eager" />
        </a>
        <ul class="hidden lg:flex items-center gap-8 text-sm tracking-widest uppercase">
          <li><a href="/about-sharon" class="hover:text-amber-400 transition-colors">About Sharon</a></li>
          <li><a href="/coaching" class="hover:text-amber-400 transition-colors">Coaching</a></li>
          <li>
            <details class="relative group/resources">
              <summary class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden hover:text-amber-400 transition-colors uppercase tracking-widest inline-flex items-center gap-1">
                Resources
                <svg class="w-3 h-3 transition-transform group-open/resources:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="absolute left-0 top-full pt-2">
                <ul class="bg-neutral-900 border border-neutral-800 py-2 min-w-[160px]">
                  <li><a href="/videos" class="block px-4 py-2 hover:bg-neutral-800">Videos</a></li>
                </ul>
              </div>
            </details>
          </li>
          <li><a href="/get-in-touch" class="hover:text-amber-400 transition-colors">Get In Touch</a></li>
        </ul>
        <div class="flex items-center gap-3">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold px-4 py-2.5 text-xs sm:text-sm tracking-wide transition-colors whitespace-nowrap"
          >
            Work with me
          </a>
          <details class="lg:hidden group/menu">
            <summary
              class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden p-2 -mr-2 hover:text-amber-400 transition-colors"
              aria-label="Toggle menu"
            >
              <svg class="w-6 h-6 group-open/menu:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round" />
                <line x1="3" y1="12" x2="21" y2="12" stroke-linecap="round" />
                <line x1="3" y1="18" x2="21" y2="18" stroke-linecap="round" />
              </svg>
              <svg class="w-6 h-6 hidden group-open/menu:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round" />
                <line x1="6" y1="18" x2="18" y2="6" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="absolute left-0 right-0 top-full bg-neutral-950 border-b border-neutral-800">
              <ul class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-1 text-sm tracking-widest uppercase">
                <li><a href="/about-sharon" class="block py-3 hover:text-amber-400 transition-colors">About Sharon</a></li>
                <li><a href="/coaching" class="block py-3 hover:text-amber-400 transition-colors">Coaching</a></li>
                <li>
                  <details class="group/mres">
                    <summary class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden py-3 hover:text-amber-400 transition-colors flex items-center justify-between">
                      Resources
                      <svg class="w-3 h-3 transition-transform group-open/mres:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </summary>
                    <ul class="pl-4 pb-2">
                      <li><a href="/videos" class="block py-2 text-neutral-300 hover:text-amber-400 transition-colors">Videos</a></li>
                    </ul>
                  </details>
                </li>
                <li><a href="/get-in-touch" class="block py-3 hover:text-amber-400 transition-colors">Get In Touch</a></li>
              </ul>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-neutral-950 border-t border-neutral-800 mt-24">
      <div class="max-w-7xl mx-auto px-6 py-16 grid gap-12 md:grid-cols-3 items-start">
        <div class="flex justify-center md:justify-start">
          <Image src={footerAccent} alt="" class="w-32 h-auto" />
        </div>
        <div class="space-y-3 text-center md:text-left">
          <p class="font-semibold tracking-widest uppercase text-amber-400">Sharon Williams Psychologist</p>
          <p>
            Phone | <a href="tel:+610409377653" class="hover:text-amber-400">+61 409 377 653</a>
          </p>
          <p>
            <a href="mailto:sharon@shawilliams.com?subject=Enquiry%20from%20Website" class="hover:text-amber-400">
              Email | sharon@shawilliams.com
            </a>
          </p>
          <p>Web | www.shawilliams.com</p>
          <ul class="flex gap-4 justify-center md:justify-start pt-2 text-sm uppercase tracking-widest">
            <li><a href="http://instagram.com/sha_williams_exec_coach" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400">Instagram</a></li>
            <li><a href="http://facebook.com/shashawilliams" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400">Facebook</a></li>
            <li><a href="https://www.youtube.com/channel/UCB0oD6fi8Tb3xvp9aFtmIhQ" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400">YouTube</a></li>
            <li><a href="https://au.linkedin.com/in/sharon-williams-65096b8" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400">LinkedIn</a></li>
          </ul>
        </div>
        <div class="flex md:justify-end">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors text-center"
          >
            Book a Complimentary Consultation
          </a>
        </div>
      </div>
      <div class="border-t border-neutral-800">
        <div class="max-w-7xl mx-auto px-6 py-6 text-xs text-neutral-500 flex flex-col md:flex-row justify-between gap-2">
          <p>&copy; 2026 | Sharon Williams Psychologist | All Rights Reserved.</p>
          <p>
            Website by |
            <a href="https://www.instagram.com/sylviastazzonelli" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400">
              Sylvia Stazzonelli
            </a>
            | Little Stylings
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
