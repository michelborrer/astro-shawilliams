---
import Layout from '../../layouts/Layout.astro';
import SiteImage from '../../components/SiteImage.astro';
import { coachingPrograms } from '../../data/coaching';
import { imagePositionClass } from '../../lib/imagePosition';
import { CALENDLY_URL } from '../../lib/links';

export function getStaticPaths() {
  return coachingPrograms.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const title = program.metaTitle;
---

<Layout
  title={title}
  description={program.metaDescription}
  path={`/coaching/${program.slug}`}
  schemaType="service"
  schemaService={{
    name: program.title,
    description: program.metaDescription,
    slug: program.slug,
  }}
>
  <section class="bg-neutral-900 py-14 md:py-20 border-b border-neutral-800/80">
    <div class="max-w-6xl mx-auto px-6">
      <nav class="text-xs tracking-[0.16em] uppercase text-neutral-400 mb-6" aria-label="Breadcrumb">
        <ol class="flex flex-wrap gap-2 items-center">
          <li><a href="/" class="hover:text-brand transition-colors focus-ring rounded-sm">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/coaching/" class="hover:text-brand transition-colors focus-ring rounded-sm">Coaching</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand">{program.title}</li>
        </ol>
      </nav>
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-brand mb-3">
        {program.hub.eyebrow}
      </p>
      <h1 class="font-serif text-4xl md:text-6xl text-white mb-4">{program.title}</h1>
      <p class="font-serif italic text-neutral-300 text-xl md:text-2xl max-w-3xl">{program.subtitle}</p>
    </div>
  </section>

  <section class="bg-neutral-950 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:gap-16 md:grid-cols-12 items-start">
      <div class="md:col-span-5">
        <SiteImage
          src={program.image}
          alt={program.imageAlt}
          preset="panel"
          class:list={['w-full aspect-[4/5] border border-neutral-800', imagePositionClass(program.imagePosition)]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="md:col-span-7 space-y-10">
        <div class="bg-neutral-900/60 border border-neutral-800 p-8 space-y-4">
          <h2 class="text-xs font-semibold tracking-[0.2em] uppercase text-brand">Who This Is For</h2>
          <div class="space-y-4 text-neutral-200 text-lg leading-relaxed">
            {program.who.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="bg-neutral-900/60 border border-neutral-800 p-8 space-y-5">
          <h2 class="text-xs font-semibold tracking-[0.2em] uppercase text-brand">What&rsquo;s Included</h2>
          <ul class="space-y-3 text-neutral-200">
            {program.included.map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-brand font-serif shrink-0 mt-0.5" aria-hidden="true">&#10003;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-7 py-3.5 text-xs sm:text-sm tracking-[0.18em] uppercase transition-colors focus-ring"
          >
            Book a Complimentary Consultation
          </a>
          <a
            href="/get-in-touch/"
            class="inline-block border border-neutral-600 hover:border-brand text-neutral-200 hover:text-brand font-semibold px-7 py-3.5 text-xs sm:text-sm tracking-[0.18em] uppercase transition-colors focus-ring"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-neutral-900 py-16 md:py-20 border-t border-neutral-800/80">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold tracking-[0.22em] uppercase text-brand mb-2">
          Compare Other Engagements
        </p>
        <h2 class="font-serif text-2xl md:text-4xl text-white">Other Programs</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {coachingPrograms
          .filter((p) => p.slug !== program.slug)
          .map((p) => (
            <a
              href={`/coaching/${p.slug}/`}
              class="group bg-neutral-950 border border-neutral-800 hover:border-brand transition-colors p-6 md:p-8 flex flex-col focus-ring"
            >
              <span class="text-xs font-semibold tracking-[0.2em] uppercase text-brand mb-2">{p.hub.eyebrow}</span>
              <h3 class="font-serif text-2xl text-white group-hover:text-brand transition-colors mb-2">{p.shortTitle}</h3>
              <p class="text-sm text-neutral-300 leading-relaxed flex-1 mb-4">{p.subtitle}</p>
              <span class="text-xs font-semibold tracking-[0.18em] uppercase text-neutral-200 group-hover:text-white inline-flex items-center gap-1.5">
                <span>View program</span>
                <span class="text-brand" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
      </div>
      <p class="mt-10 text-center">
        <a href="/about-sharon/" class="text-xs sm:text-sm font-semibold tracking-[0.18em] uppercase text-brand hover:text-brand-hover focus-ring rounded-sm">
          Learn about Sharon&rsquo;s approach &rarr;
        </a>
      </p>
    </div>
  </section>
</Layout>
