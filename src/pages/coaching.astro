---
import Layout from '../layouts/Layout.astro';
import SiteImage from '../components/SiteImage.astro';
import heroChess from '../assets/images/coaching-hero-chess.jpg';
import standOut from '../assets/images/coaching-stand-out.jpg';
import { imagePositionClass } from '../lib/imagePosition';
import { coachingPrograms, howIWork, coachingOutcomes } from '../data/coaching';

const title = 'Executive Coaching Programs | Sharon Williams';
const description =
  'Compare a personal diagnostic, a new-CEO transition, and a senior-team reset. Each program starts with assessment.';
---

<Layout title={title} description={description} path="/coaching" schemaType="person">
  <section class="relative">
    <SiteImage
      src={heroChess}
      alt="Chess pieces"
      class="w-full h-[calc(100vh-80px)] object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/20 to-neutral-950/80"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 pb-12 md:pb-16 w-full">
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl tracking-tight max-w-4xl">
          EXECUTIVE coaching
        </h1>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl">
          Psychometric diagnostics and sustained advisory for CEOs and C-suite leaders across Australia.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-neutral-900 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl mb-12 text-center">How I work</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {howIWork.map((step) => (
          <article class="bg-neutral-950 border border-neutral-800 p-8">
            <h3 class="font-serif text-2xl md:text-3xl text-white mb-4">{step.title}</h3>
            <p class="text-neutral-300 leading-relaxed">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-neutral-950 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Which engagement</h2>
      <p class="text-neutral-300 text-lg leading-relaxed max-w-3xl mb-12">
        Three ways to work together. Choose by the question in front of you. Who each program is for, and everything included, is on that program’s own page.
      </p>
      <div class="grid gap-8 lg:grid-cols-3">
        {coachingPrograms.map((program) => (
          <article id={program.anchorId} class="scroll-mt-24 bg-neutral-900 border border-neutral-800 flex flex-col">
            <SiteImage
              src={program.image}
              alt={program.imageAlt}
              preset="card"
              class:list={['w-full aspect-[4/5]', imagePositionClass(program.imagePosition)]}
            />
            <div class="p-8 flex flex-col flex-1">
              <p class="text-xs tracking-widest uppercase text-neutral-400">{program.hub.eyebrow}</p>
              <h3 class="font-serif text-2xl md:text-3xl mt-3">{program.title}</h3>
              <p class="mt-4 text-neutral-300 leading-relaxed">{program.hub.summary}</p>
              <dl class="mt-6 space-y-4">
                <div>
                  <dt class="text-xs tracking-widest uppercase text-white">Suited to</dt>
                  <dd class="mt-1 text-neutral-300">{program.hub.suitedTo}</dd>
                </div>
                <div>
                  <dt class="text-xs tracking-widest uppercase text-white">Focus</dt>
                  <dd class="mt-1 text-neutral-300">{program.hub.focus}</dd>
                </div>
                <div>
                  <dt class="text-xs tracking-widest uppercase text-white">How it runs</dt>
                  <dd class="mt-1 text-neutral-300">{program.hub.runs}</dd>
                </div>
              </dl>
              <a
                href={`/coaching/${program.slug}/`}
                aria-label={`${program.shortTitle}: read the full program`}
                class="inline-block mt-auto pt-8 self-start border border-neutral-600 hover:border-amber-400 text-neutral-200 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
              >
                Read the full program
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative">
    <SiteImage src={standOut} alt="Stand out from the crowd" class="w-full h-[40vh] md:h-[55vh] object-cover" />
    <div class="absolute inset-0 bg-neutral-950/40"></div>
  </section>

  <section class="bg-neutral-950 py-24">
    <div class="max-w-3xl mx-auto px-6 space-y-12">
      <h2 class="font-serif text-3xl md:text-4xl text-center">What Changes</h2>
      <blockquote class="font-serif text-2xl md:text-3xl leading-relaxed italic text-center">
        "When the diagnostic work is done, my clients don't just perform better, they lead differently."
      </blockquote>
      <ul class="space-y-4 text-neutral-300 text-lg list-disc pl-5">
        {coachingOutcomes.map((outcome) => <li>{outcome}</li>)}
      </ul>
      <blockquote class="font-serif text-2xl md:text-3xl leading-relaxed italic text-center text-white">
        "This isn't about becoming a different leader, it's about removing what's in the way of the
        leader you already are."
      </blockquote>
      <p class="text-center">
        <a href="/about-sharon" class="text-white text-sm tracking-widest uppercase hover:underline focus-ring rounded-sm">
          About Sharon's credentials &rarr;
        </a>
      </p>
    </div>
  </section>
</Layout>
