---
import Layout from '../layouts/Layout.astro';
import SiteImage from '../components/SiteImage.astro';
import heroOneStep from '../assets/images/contact-hero-one-small-step.jpg';
import leadershipCoach from '../assets/images/contact-leadership-coach.jpg';
import { CALENDLY_URL, EMAIL, MAILTO_ENQUIRY } from '../lib/links';
import ContactForm from '../components/ContactForm.astro';

const title = 'Book Executive Coaching | Sharon Williams';
const description =
  'Arrange a conversation about coaching for a CEO, a new chief executive, or a senior leadership team in Australia.';
---

<Layout title={title} description={description} path="/get-in-touch">
  <section class="relative overflow-hidden">
    <SiteImage
      src={heroOneStep}
      alt="A path forward"
      class="w-full h-[calc(100vh-80px)] min-h-[540px] img-cover-bottom-right"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/25 to-neutral-950/85"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 pb-12 md:pb-16 w-full">
        <p class="text-xs md:text-sm font-semibold tracking-[0.22em] uppercase text-brand mb-3">
          Confidential Enquiry
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight text-white max-w-4xl">
          It Starts With One Small Step
        </h1>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl">
          Arrange a confidential discussion about executive assessment, a CEO transition, or a leadership team reset.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-neutral-950 py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 lg:grid-cols-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 space-y-8">
        <div>
          <p class="text-xs font-semibold tracking-[0.22em] uppercase text-brand mb-2">
            Direct Advisory
          </p>
          <h2 class="font-serif text-3xl md:text-5xl text-white">Get in Touch</h2>
        </div>
        <div class="mx-auto lg:mx-0 w-64 h-64 sm:w-72 sm:h-72 rounded-full overflow-hidden border-2 border-brand/40 shadow-2xl">
          <SiteImage
            src={leadershipCoach}
            alt="Sharon Williams — Leadership Coach to CEOs and Executives"
            preset="avatar"
            class="w-full h-full img-cover-circle-portrait"
          />
        </div>
        <div class="space-y-4 text-neutral-300 text-lg leading-relaxed max-w-md">
          <p>
            Every leadership challenge is unique. Sharon offers executive coaching and keynote addresses to
            senior leaders across Australia and internationally — and is currently accepting new clients.
          </p>
          <p class="text-white font-medium">Reach out to start the conversation.</p>
        </div>

        <div class="pt-4 border-t border-neutral-800/80 space-y-3 text-sm">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-brand">Direct Details</p>
          <p class="text-neutral-300">
            Phone:
            <a href="tel:+610409377653" class="text-white hover:text-brand transition-colors ml-1 focus-ring rounded-sm">
              +61 409 377 653
            </a>
          </p>
          <p class="text-neutral-300">
            Email:
            <a href={MAILTO_ENQUIRY} class="text-white hover:text-brand transition-colors ml-1 focus-ring rounded-sm">
              {EMAIL}
            </a>
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 bg-neutral-900 border border-neutral-800 p-8 md:p-10 space-y-8">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-brand mb-2">Send a Message</p>
          <h3 class="font-serif text-2xl text-white">Enquire About Working Together</h3>
        </div>
        <ContactForm />
        <div class="pt-4 border-t border-neutral-800 flex flex-col gap-4">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-400">
            Prefer to schedule directly?
          </p>
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block border border-brand/70 hover:bg-brand hover:text-neutral-950 text-brand font-semibold px-8 py-3.5 text-xs sm:text-sm tracking-[0.18em] uppercase transition-colors text-center focus-ring"
          >
            Book a Complimentary Consultation
          </a>
        </div>
        <div class="pt-6 border-t border-neutral-800">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-400 mb-4">
            Inquiring About a Specific Program?
          </p>
          <ul class="grid sm:grid-cols-3 gap-3 text-xs font-semibold tracking-[0.16em] uppercase">
            <li>
              <a
                href="/coaching/executive-deep-dive/"
                class="block bg-neutral-950 border border-neutral-800 hover:border-brand text-neutral-200 hover:text-brand px-4 py-3 text-center transition-colors focus-ring"
              >
                Executive Deep Dive
              </a>
            </li>
            <li>
              <a
                href="/coaching/ceo-transition/"
                class="block bg-neutral-950 border border-neutral-800 hover:border-brand text-neutral-200 hover:text-brand px-4 py-3 text-center transition-colors focus-ring"
              >
                CEO Transition
              </a>
            </li>
            <li>
              <a
                href="/coaching/team-reset/"
                class="block bg-neutral-950 border border-neutral-800 hover:border-brand text-neutral-200 hover:text-brand px-4 py-3 text-center transition-colors focus-ring"
              >
                Team Reset
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
