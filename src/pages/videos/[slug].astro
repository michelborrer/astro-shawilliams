---
import Layout from '../../layouts/Layout.astro';
import { videos, getRelatedVideos } from '../../data/videos';

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: video.slug },
    props: { video },
  }));
}

const { video } = Astro.props;
const allVideos = videos;
const currentIndex = allVideos.findIndex((v) => v.slug === video.slug);
const prev = currentIndex > 0 ? allVideos[currentIndex - 1] : null;
const next = currentIndex < allVideos.length - 1 ? allVideos[currentIndex + 1] : null;
const related = getRelatedVideos(video.slug, 4);

const title = `${video.title} — Sharon Williams Psychologist`;
const description = video.description;
const ogImage = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;
---

<Layout
  title={title}
  description={description}
  path={`/videos/${video.slug}`}
  ogImage={ogImage}
  schemaType="video"
  schemaVideo={{
    title: video.title,
    description: video.description,
    youtubeId: video.youtubeId,
    slug: video.slug,
    published: video.published,
  }}
>
  <article>
    <section class="bg-neutral-900 py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-6">
        <nav class="text-sm text-neutral-400 mb-6" aria-label="Breadcrumb">
          <ol class="flex flex-wrap gap-2 items-center">
            <li><a href="/" class="hover:text-amber-400 focus-ring rounded-sm">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/videos" class="hover:text-amber-400 focus-ring rounded-sm">Videos</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-neutral-200">{video.title}</li>
          </ol>
        </nav>
        <p class="text-amber-400 text-xs tracking-widest uppercase mb-3">{video.category}</p>
        <h1 class="font-serif text-3xl md:text-5xl mb-4">{video.title}</h1>
        <p class="text-neutral-300 text-lg leading-relaxed max-w-3xl">{video.description}</p>
      </div>
    </section>

    <section class="bg-neutral-950 py-8">
      <div class="max-w-4xl mx-auto px-6">
        <div class="aspect-video bg-neutral-900 border border-neutral-800">
          <iframe
            src={`https://www.youtube.com/embed/${video.youtubeId}`}
            title={video.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="bg-neutral-950 pb-16">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row justify-between gap-4 text-sm tracking-widest uppercase">
        {prev ? (
          <a href={`/videos/${prev.slug}`} class="text-amber-400 hover:underline focus-ring rounded-sm">
            &larr; {prev.title}
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`/videos/${next.slug}`} class="text-amber-400 hover:underline focus-ring rounded-sm sm:text-right">
            {next.title} &rarr;
          </a>
        )}
      </div>
    </section>

    <section class="bg-neutral-900 py-20 border-t border-neutral-800">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-serif text-2xl md:text-3xl mb-10">You might also like</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {related.map((item) => (
            <a
              href={`/videos/${item.slug}`}
              class="group bg-neutral-950 border border-neutral-800 hover:border-amber-500 transition-colors flex flex-col focus-ring"
            >
              <div class="aspect-video overflow-hidden motion-safe-hover-scale">
                <img
                  src={`https://i.ytimg.com/vi/${item.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500"
                />
              </div>
              <div class="p-4">
                <h3 class="font-serif text-lg">{item.title}</h3>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-12 text-center">
          <a
            href="/coaching"
            class="inline-block bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold px-8 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
          >
            Explore executive coaching
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>
