---
import { absoluteUrl, EMAIL, PHONE, SITE_NAME } from '../lib/site';
import { CALENDLY_URL } from '../lib/links';

interface Props {
  type?: 'home' | 'person' | 'video' | 'service';
  video?: {
    title: string;
    description: string;
    youtubeId: string;
    slug: string;
    published?: string;
    updated?: string;
    duration?: string;
    transcript?: string;
    chapters?: { name: string; startOffset: number }[];
  };
  service?: {
    name: string;
    description: string;
    slug: string;
  };
}

const { type = 'home', video, service } = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sharon Williams',
  jobTitle: 'Registered Psychologist & Executive Coach',
  description:
    'Psychologist and trusted advisor to CEOs and C-suite executives across Australia, specialising in psychometric assessment and leadership derailer identification.',
  url: absoluteUrl('/'),
  email: EMAIL,
  telephone: PHONE,
  sameAs: [
    'https://www.youtube.com/channel/UCB0oD6fi8Tb3xvp9aFtmIhQ',
    'https://au.linkedin.com/in/sharon-williams-65096b8',
    'https://www.instagram.com/sharon_williams_psychologist/',
    'https://www.facebook.com/sharonwilliamspsychologist',
  ],
  knowsAbout: [
    'Executive coaching',
    'Leadership psychology',
    'Psychometric assessment',
    'CEO transition',
    'Leadership team development',
  ],
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE_NAME,
  url: absoluteUrl('/'),
  description:
    'Executive coaching and psychological assessment for CEOs and C-suite leaders in Australia.',
  email: EMAIL,
  telephone: PHONE,
  areaServed: 'AU',
  priceRange: '$$$$',
  founder: { '@type': 'Person', name: 'Sharon Williams' },
  sameAs: personSchema.sameAs,
  potentialAction: {
    '@type': 'ReserveAction',
    target: CALENDLY_URL,
    name: 'Book a Complimentary Consultation',
  },
};

const schemas: Record<string, unknown>[] = [personSchema, businessSchema];

if (type === 'video' && video) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: video.title,
    description: video.description,
    thumbnailUrl: `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`,
    embedUrl: `https://www.youtube.com/embed/${video.youtubeId}`,
    contentUrl: `https://www.youtube.com/watch?v=${video.youtubeId}`,
    uploadDate: video.published,
    dateModified: video.updated,
    duration: video.duration,
    transcript: video.transcript,
    url: absoluteUrl(`/videos/${video.slug}`),
    publisher: { '@type': 'Person', name: 'Sharon Williams' },
    hasPart: video.chapters?.map((chapter) => ({
      '@type': 'Clip',
      name: chapter.name,
      startOffset: chapter.startOffset,
      url: `https://www.youtube.com/watch?v=${video.youtubeId}&t=${chapter.startOffset}`,
    })),
  });
}

if (type === 'service' && service) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.description,
    provider: { '@type': 'Person', name: 'Sharon Williams' },
    url: absoluteUrl(`/coaching/${service.slug}`),
    areaServed: 'AU',
    audience: { '@type': 'Audience', audienceType: 'CEOs and C-suite executives' },
  });
}
---

<script type="application/ld+json" set:html={JSON.stringify(schemas)} />
