---
import Layout from '../layouts/Layout.astro';
import SiteImage from '../components/SiteImage.astro';
import heroFlight from '../assets/images/videos-hero-leadership-flight.jpg';
import { videos, videoCategories } from '../data/videos';
import { formatDuration, videoGuides } from '../data/video-guides';

const title = 'Leadership Lessons for Executives | Sharon Williams';
const description =
  'Short lessons for senior leaders on decisions, derailers, strategy time and recovery. Each one includes a written guide.';
---

<Layout title={title} description={description} path="/videos">
  <section class="relative overflow-hidden">
    <SiteImage
      src={heroFlight}
      alt="Leadership in Flight Programme"
      class="w-full h-[calc(100vh-80px)] min-h-[540px] object-cover object-right md:object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/25 to-neutral-950/85"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 pb-12 md:pb-16 w-full">
        <p class="text-xs md:text-sm font-semibold tracking-[0.22em] uppercase text-brand mb-3">
          Executive Video Library &amp; Written Guides
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight text-white max-w-4xl">
          Shorts from Sharon
        </h1>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl">
          Leadership insights on strategy, performance, and the psychology of exceptional executives.
        </p>
      </div>
    </div>
  </section>

  {videoCategories.map((category, categoryIdx) => {
    const items = videos.filter((v) => v.category === category);
    return (
      <section class="bg-neutral-950 py-20 md:py-24 border-b border-neutral-900 last:border-b-0">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 pb-6 border-b border-neutral-800/80">
            <div>
              <p class="text-xs font-semibold tracking-[0.22em] uppercase text-brand mb-2">
                Series 0{categoryIdx + 1}
              </p>
              <h2 class="font-serif text-2xl md:text-4xl text-white">{category}</h2>
            </div>
            <p class="text-xs tracking-[0.18em] uppercase text-neutral-400">
              {items.length} Lessons with Written Guides
            </p>
          </div>
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {items.map((video) => {
              const guide = videoGuides[video.slug];
              const durationBadge = guide ? formatDuration(guide.durationSeconds) : null;
              return (
                <article class="group bg-neutral-900 border border-neutral-800 hover:border-brand transition-colors flex flex-col">
                  <a
                    href={`/videos/${video.slug}/`}
                    class="relative block aspect-video overflow-hidden motion-safe-hover-scale bg-neutral-950 focus-ring"
                  >
                    <img
                      src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/70 via-neutral-950/15 to-transparent"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="w-12 h-12 rounded-full bg-neutral-950/75 border border-brand/80 text-brand group-hover:bg-brand group-hover:text-neutral-950 transition-all duration-300 flex items-center justify-center shadow-lg">
                        <svg class="w-4 h-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </div>
                    {durationBadge && (
                      <span class="absolute bottom-2.5 right-2.5 bg-neutral-950/85 border border-neutral-700/80 text-neutral-200 text-xs tabular-nums px-2 py-0.5">
                        {durationBadge}
                      </span>
                    )}
                  </a>
                  <div class="p-6 flex-1 flex flex-col gap-3">
                    <h3 class="font-serif text-xl md:text-2xl text-white group-hover:text-brand transition-colors">
                      <a href={`/videos/${video.slug}/`} class="focus-ring rounded-sm">
                        {video.title}
                      </a>
                    </h3>
                    <p class="text-sm text-neutral-300 leading-relaxed flex-1">
                      {video.description}
                    </p>
                    <a
                      href={`/videos/${video.slug}/`}
                      class="pt-3 text-neutral-200 group-hover:text-white text-xs font-semibold tracking-[0.18em] uppercase self-start inline-flex items-center gap-1.5 focus-ring rounded-sm"
                    >
                      <span>Watch &amp; read guide</span>
                      <span class="text-brand" aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-neutral-900 py-20 border-t border-neutral-800/80">
    <div class="max-w-3xl mx-auto px-6 text-center space-y-6">
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-brand">
        From Insight to Intervention
      </p>
      <h2 class="font-serif text-3xl md:text-4xl text-white">
        Ready to Uncover What&rsquo;s Holding You Back?
      </h2>
      <p class="text-neutral-300 text-lg leading-relaxed">
        Sharon&rsquo;s coaching programs use clinical-grade assessment to uncover the
        derailers these videos describe.
      </p>
      <div class="pt-2">
        <a
          href="/coaching/"
          class="inline-block bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-8 py-3.5 text-xs sm:text-sm tracking-[0.18em] uppercase transition-colors focus-ring"
        >
          Explore Coaching Programs
        </a>
      </div>
    </div>
  </section>
</Layout>
