---
import Layout from '../../layouts/Layout.astro';
import SiteImage from './SiteImage.astro';
import type { CoachingProgram } from '../../data/coaching';
import { imagePositionClass } from '../lib/imagePosition';

interface Props {
  program: CoachingProgram;
  reversed?: boolean;
}

const { program, reversed = false } = Astro.props;
---

<section id={program.anchorId} class="py-20 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-6 grid gap-10 md:gap-16 md:grid-cols-2 items-center">
    <div class={reversed ? 'md:order-2' : ''}>
      <SiteImage
        src={program.image}
        alt={program.imageAlt}
        preset="panel"
        class:list={['w-full aspect-[4/5]', imagePositionClass(program.imagePosition)]}
      />
    </div>
    <div class="space-y-6">
      <div>
        <h2 class="font-serif text-3xl md:text-4xl">{program.title}</h2>
        <p class="italic text-neutral-400 mt-2">{program.subtitle}</p>
      </div>
      <div>
        <h3 class="text-xs tracking-widest uppercase text-white mb-3">Who this is for</h3>
        <div class="space-y-3 text-neutral-300 leading-relaxed">
          {program.who.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <h3 class="text-xs tracking-widest uppercase text-white mb-3">What's included</h3>
        <ul class="space-y-2 text-neutral-300 list-disc pl-5">
          {program.included.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="flex flex-wrap gap-4">
        <a
          href={program.ctaHref}
          target={program.ctaHref.startsWith('http') ? '_blank' : undefined}
          rel={program.ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-block bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
        >
          {program.ctaLabel}
        </a>
        <a
          href={`/coaching/${program.slug}`}
          class="inline-block border border-neutral-600 hover:border-amber-400 text-neutral-200 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
        >
          Full program details
        </a>
      </div>
    </div>
  </div>
</section>
