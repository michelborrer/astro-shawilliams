---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import footerAccent from '../assets/images/footer-red.png';
import SEO from '../components/SEO.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import NavLink from '../components/NavLink.astro';
import { CALENDLY_URL, EMAIL, MAILTO_ENQUIRY } from '../lib/links';
import { SITE_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  schemaType?: 'home' | 'person' | 'video' | 'service';
  schemaVideo?: {
    title: string;
    description: string;
    youtubeId: string;
    slug: string;
    published?: string;
  };
  schemaService?: {
    name: string;
    description: string;
    slug: string;
  };
  noindex?: boolean;
}

const {
  title = 'Sharon Williams | Psychologist & Trusted Advisor for CEOs and C-Suite Executives',
  description = "Registered psychologist and executive coach with over 20 years' experience working with CEOs and C-suite leaders to overcome self-sabotage, build resilience and drive lasting performance.",
  path,
  ogImage,
  schemaType = 'home',
  schemaVideo,
  schemaService,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const resourcesActive = pathname === '/videos' || pathname.startsWith('/videos/');
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SEO title={title} description={description} path={path} image={ogImage} noindex={noindex} />
    <SchemaMarkup type={schemaType} video={schemaVideo} service={schemaService} />
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand focus:text-neutral-950 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-50 bg-neutral-950/90 backdrop-blur border-b border-neutral-800">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6" aria-label="Main">
        <a href="/" class="flex items-center shrink-0 focus-ring rounded-sm">
          <Image src={logo} alt="Sharon Williams" class="h-12 w-auto" loading="eager" />
        </a>
        <ul class="hidden lg:flex items-center gap-8 text-sm tracking-widest uppercase">
          <li><NavLink href="/about-sharon">About Sharon</NavLink></li>
          <li><NavLink href="/coaching" match="prefix">Coaching</NavLink></li>
          <li>
            <details class="relative group/resources">
              <summary
                class:list={[
                  'cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden uppercase tracking-widest inline-flex items-center gap-1 focus-ring rounded-sm',
                  'text-white hover:text-brand transition-colors',
                ]}
              >
                Resources
                <svg class="w-3 h-3 transition-transform group-open/resources:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="absolute left-0 top-full pt-2">
                <ul class="bg-neutral-900 border border-neutral-800 py-2 min-w-[160px]">
                  <li>
                    <NavLink href="/videos" class="block px-4 py-2 hover:bg-neutral-800" match="prefix">
                      Videos
                    </NavLink>
                  </li>
                </ul>
              </div>
            </details>
          </li>
          <li><NavLink href="/get-in-touch">Get In Touch</NavLink></li>
        </ul>
        <div class="flex items-center gap-3">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-4 py-2.5 text-xs sm:text-sm tracking-wide transition-colors whitespace-nowrap focus-ring"
          >
            Work with me
          </a>
          <details class="lg:hidden group/menu" id="mobile-menu">
            <summary
              class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden p-2 -mr-2 text-white hover:text-brand transition-colors focus-ring rounded-sm"
              aria-label="Toggle menu"
            >
              <svg class="w-6 h-6 group-open/menu:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round" />
                <line x1="3" y1="12" x2="21" y2="12" stroke-linecap="round" />
                <line x1="3" y1="18" x2="21" y2="18" stroke-linecap="round" />
              </svg>
              <svg class="w-6 h-6 hidden group-open/menu:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round" />
                <line x1="6" y1="18" x2="18" y2="6" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="absolute left-0 right-0 top-full bg-neutral-950 border-b border-neutral-800">
              <ul class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-1 text-sm tracking-widest uppercase mobile-nav-links">
                <li><NavLink href="/about-sharon" class="block py-3">About Sharon</NavLink></li>
                <li><NavLink href="/coaching" class="block py-3" match="prefix">Coaching</NavLink></li>
                <li><NavLink href="/videos" class="block py-3" match="prefix">Videos</NavLink></li>
                <li><NavLink href="/get-in-touch" class="block py-3">Get In Touch</NavLink></li>
              </ul>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="bg-neutral-950 border-t border-neutral-800 mt-24">
      <div class="max-w-7xl mx-auto px-6 py-16 grid gap-12 md:grid-cols-3 items-start">
        <div class="flex justify-center md:justify-start">
          <Image src={footerAccent} alt="" class="w-32 h-auto" />
        </div>
        <div class="space-y-3 text-center md:text-left">
          <p class="font-semibold tracking-widest uppercase text-amber-400">Sharon Williams Psychologist</p>
          <p>
            Phone | <a href="tel:+610409377653" class="hover:text-amber-400 focus-ring rounded-sm">+61 409 377 653</a>
          </p>
          <p>
            <a href={MAILTO_ENQUIRY} class="hover:text-amber-400 focus-ring rounded-sm">
              Email | {EMAIL}
            </a>
          </p>
          <p>
            Web |
            <a href={SITE_URL} class="hover:text-amber-400 focus-ring rounded-sm ml-1">
              {SITE_URL.replace('https://', '')}
            </a>
          </p>
          <ul class="flex flex-wrap gap-4 justify-center md:justify-start pt-2 text-sm uppercase tracking-widest">
            <li><a href="http://instagram.com/sha_williams_exec_coach" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 focus-ring rounded-sm">Instagram</a></li>
            <li><a href="http://facebook.com/shashawilliams" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 focus-ring rounded-sm">Facebook</a></li>
            <li><a href="https://www.youtube.com/channel/UCB0oD6fi8Tb3xvp9aFtmIhQ" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 focus-ring rounded-sm">YouTube</a></li>
            <li><a href="https://au.linkedin.com/in/sharon-williams-65096b8" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 focus-ring rounded-sm">LinkedIn</a></li>
          </ul>
        </div>
        <div class="flex md:justify-end">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors text-center focus-ring"
          >
            Book a Complimentary Consultation
          </a>
        </div>
      </div>
      <div class="border-t border-neutral-800">
        <div class="max-w-7xl mx-auto px-6 py-6 text-xs text-neutral-500 flex flex-col md:flex-row justify-between gap-2">
          <p>&copy; 2026 | Sharon Williams Psychologist | All Rights Reserved.</p>
          <p class="flex flex-wrap gap-x-2 gap-y-1 justify-end">
            <a href="/privacy-policy" class="hover:text-amber-400 focus-ring rounded-sm">Privacy Policy</a>
            <span aria-hidden="true">|</span>
            <span>
              Website by
              <a href="https://www.instagram.com/sylviastazzonelli" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 focus-ring rounded-sm">
                Sylvia Stazzonelli
              </a>
              | Little Stylings
            </span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('.mobile-nav-links a').forEach((link) => {
        link.addEventListener('click', () => {
          const menu = document.getElementById('mobile-menu');
          if (menu instanceof HTMLDetailsElement) menu.open = false;
        });
      });
    </script>
  </body>
</html>
