---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy Policy — Sharon Williams Psychologist';
const description =
  'Privacy policy for shawilliams.com — how Sharon Williams Psychologist collects, uses and protects your personal information.';
---

<Layout title={title} description={description} path="/privacy-policy">
  <section class="bg-neutral-900 py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="font-serif text-4xl md:text-5xl mb-8">Privacy Policy</h1>
      <div class="space-y-6 text-neutral-300 leading-relaxed">
        <p>
          Sharon Williams Psychologist ("we", "us") respects your privacy. This policy explains how we
          handle personal information collected through this website.
        </p>
        <h2 class="font-serif text-2xl text-amber-400 pt-4">Information we collect</h2>
        <p>
          When you contact us by email, phone or booking link, we may collect your name, email address,
          phone number and any information you choose to provide in your message.
        </p>
        <h2 class="font-serif text-2xl text-amber-400 pt-4">How we use your information</h2>
        <p>
          We use your information to respond to enquiries, schedule consultations, and provide executive
          coaching services. We do not sell your personal information to third parties.
        </p>
        <h2 class="font-serif text-2xl text-amber-400 pt-4">Third-party services</h2>
        <p>
          We use Calendly for appointment scheduling and YouTube for embedded video content. These
          services have their own privacy policies governing data they collect.
        </p>
        <h2 class="font-serif text-2xl text-amber-400 pt-4">Contact</h2>
        <p>
          For privacy enquiries, contact
          <a href="mailto:sharon@shawilliams.com" class="text-amber-400 hover:underline focus-ring rounded-sm">
            sharon@shawilliams.com
          </a>.
        </p>
        <p class="text-sm text-neutral-500 pt-8">Last updated: July 2026</p>
      </div>
    </div>
  </section>
</Layout>
