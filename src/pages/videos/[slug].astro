---
import Layout from '../../layouts/Layout.astro';
import { videos, getRelatedVideos } from '../../data/videos';
import {
  VIDEO_GUIDE_UPDATED,
  chapterStartSeconds,
  isoDuration,
  videoGuides,
} from '../../data/video-guides';
import { getCoachingProgram } from '../../data/coaching';

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: video.slug },
    props: { video },
  }));
}

const { video } = Astro.props;
const guide = videoGuides[video.slug];
const program = getCoachingProgram(guide.coachingSlug);
if (!program) {
  throw new Error(`Missing coaching program for ${video.slug}`);
}

const allVideos = videos;
const currentIndex = allVideos.findIndex((v) => v.slug === video.slug);
const prev = currentIndex > 0 ? allVideos[currentIndex - 1] : null;
const next = currentIndex < allVideos.length - 1 ? allVideos[currentIndex + 1] : null;
const related = getRelatedVideos(video.slug, 4);

const title = `${video.title} — Sharon Williams Psychologist`;
const description = video.description;
const ogImage = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;

function formatDate(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const publishedLabel = video.published ? formatDate(video.published) : null;
const updatedLabel = formatDate(VIDEO_GUIDE_UPDATED);
const minutes = Math.floor(guide.durationSeconds / 60);
const seconds = guide.durationSeconds % 60;
const durationLabel = seconds === 0 ? `${minutes} min` : `${minutes} min ${seconds} sec`;
---

<Layout
  title={title}
  description={description}
  path={`/videos/${video.slug}`}
  ogImage={ogImage}
  schemaType="video"
  schemaVideo={{
    title: video.title,
    description: guide.summary,
    youtubeId: video.youtubeId,
    slug: video.slug,
    published: video.published,
    updated: VIDEO_GUIDE_UPDATED,
    duration: isoDuration(guide.durationSeconds),
    transcript: guide.transcript.join('\n\n'),
    chapters: guide.chapters.map((chapter) => ({
      name: chapter.label,
      startOffset: chapterStartSeconds(chapter.time),
    })),
  }}
>
  <article>
    <section class="bg-neutral-900 py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-6">
        <nav class="text-sm text-neutral-400 mb-6" aria-label="Breadcrumb">
          <ol class="flex flex-wrap gap-2 items-center">
            <li><a href="/" class="hover:text-white focus-ring rounded-sm">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/videos" class="hover:text-white focus-ring rounded-sm">Videos</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-neutral-200">{video.title}</li>
          </ol>
        </nav>
        <p class="text-white text-xs tracking-widest uppercase mb-3">{video.category}</p>
        <h1 class="font-serif text-3xl md:text-5xl mb-4">{video.title}</h1>
        <p class="text-sm text-neutral-400 mb-6 flex flex-wrap gap-x-3 gap-y-1">
          {publishedLabel && video.published && (
            <span>Published <time datetime={video.published}>{publishedLabel}</time></span>
          )}
          <span aria-hidden="true">·</span>
          <span>Guide updated <time datetime={VIDEO_GUIDE_UPDATED}>{updatedLabel}</time></span>
          <span aria-hidden="true">·</span>
          <span>{durationLabel}</span>
        </p>
        <p class="text-neutral-300 text-lg leading-relaxed max-w-3xl">{guide.summary}</p>
      </div>
    </section>

    <section class="bg-neutral-950 py-8">
      <div class="max-w-4xl mx-auto px-6">
        <div class="aspect-video bg-neutral-900 border border-neutral-800">
          <iframe
            name="lesson-video"
            src={`https://www.youtube.com/embed/${video.youtubeId}`}
            title={video.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="bg-neutral-950 pb-16">
      <div class="max-w-3xl mx-auto px-6 space-y-14">
        <div>
          <h2 class="font-serif text-2xl md:text-3xl">Key takeaways</h2>
          <ul class="mt-6 space-y-3 text-neutral-300 leading-relaxed">
            {guide.takeaways.map((item) => (
              <li class="flex gap-3">
                <span class="text-brand shrink-0" aria-hidden="true">–</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl md:text-3xl">Chapters</h2>
          <p class="mt-3 text-sm text-neutral-400">Select a chapter to play the video from that point.</p>
          <ol class="mt-6 border border-neutral-800 divide-y divide-neutral-800">
            {guide.chapters.map((chapter) => (
              <li>
                <a
                  href={`https://www.youtube.com/embed/${video.youtubeId}?start=${chapterStartSeconds(chapter.time)}`}
                  target="lesson-video"
                  data-chapter
                  class="flex gap-4 px-4 py-3 hover:bg-neutral-900 focus-ring"
                >
                  <time class="text-brand text-sm tabular-nums w-12 shrink-0" datetime={`PT${chapterStartSeconds(chapter.time)}S`}>
                    {chapter.time}
                  </time>
                  <span>{chapter.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div>
          <h2 class="font-serif text-2xl md:text-3xl">Edited transcript</h2>
          <div class="mt-6 space-y-4 text-neutral-300 leading-relaxed">
            {guide.transcript.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <aside class="border border-neutral-800 bg-neutral-900 p-6 md:p-8">
          <p class="text-xs tracking-widest uppercase text-neutral-400">Related coaching</p>
          <h2 class="font-serif text-2xl md:text-3xl mt-3">{program.title}</h2>
          <p class="mt-4 text-neutral-300 leading-relaxed">{guide.coachingNote}</p>
          <a
            href={`/coaching/${program.slug}/`}
            class="inline-block mt-6 bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-6 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
          >
            View this program
          </a>
        </aside>
      </div>
    </section>

    <section class="bg-neutral-950 pb-16">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row justify-between gap-4 text-sm tracking-widest uppercase">
        {prev ? (
          <a href={`/videos/${prev.slug}`} class="text-white hover:underline focus-ring rounded-sm">
            &larr; {prev.title}
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`/videos/${next.slug}`} class="text-white hover:underline focus-ring rounded-sm sm:text-right">
            {next.title} &rarr;
          </a>
        )}
      </div>
    </section>

    <section class="bg-neutral-900 py-20 border-t border-neutral-800">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-serif text-2xl md:text-3xl mb-10">You might also like</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {related.map((item) => (
            <a
              href={`/videos/${item.slug}`}
              class="group bg-neutral-950 border border-neutral-800 hover:border-amber-500 transition-colors flex flex-col focus-ring"
            >
              <div class="aspect-video overflow-hidden motion-safe-hover-scale">
                <img
                  src={`https://i.ytimg.com/vi/${item.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500"
                />
              </div>
              <div class="p-4">
                <h3 class="font-serif text-lg">{item.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</Layout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('iframe[name="lesson-video"]');
  document.querySelectorAll<HTMLAnchorElement>('a[data-chapter]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!frame) return;
      event.preventDefault();
      frame.src = link.href;
      frame.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
