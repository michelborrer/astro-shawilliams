---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import SiteImage from '../components/SiteImage.astro';
import heroGlassCeiling from '../assets/images/hero-glass-ceiling.jpg';
import executiveCoach from '../assets/images/executive-coach.jpg';
import sydneyHarbourBridge from '../assets/images/sydney-harbour-bridge.jpg';
import videoDarkSide from '../assets/images/video-dark-side.jpg';
import videoStrategy from '../assets/images/video-strategy.jpg';
import videoEliteRowers from '../assets/images/video-elite-rowers.jpg';
import { coachingPrograms } from '../data/coaching';
import { videos } from '../data/videos';
import NewsletterForm from '../components/NewsletterForm.astro';

const featuredVideoSlugs = [
  'how-your-dark-side-can-self-sabotage-your-leadership',
  'why-strategy-time-should-be-your-priority',
  'why-elite-performers-have-a-morning-routine',
  'recovery-time',
];

const featuredImages: Record<string, ImageMetadata> = {
  'how-your-dark-side-can-self-sabotage-your-leadership': videoDarkSide,
  'why-strategy-time-should-be-your-priority': videoStrategy,
  'why-elite-performers-have-a-morning-routine': videoEliteRowers,
};

const featuredVideos = featuredVideoSlugs
  .map((slug) => videos.find((v) => v.slug === slug))
  .filter((v): v is (typeof videos)[number] => Boolean(v));

/**
 * The positioning line stays on the hero either way.
 * Set this to false to restore the original hero, where that line is the H1.
 */
const serviceLedHero = true;
---

<Layout schemaType="person">
  <section class="relative">
    <SiteImage
      src={heroGlassCeiling}
      alt="Glass ceiling viewed from below"
      class="w-full h-[calc(100vh-80px)] object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/45 to-neutral-950/70"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-7xl mx-auto px-6 w-full">
        {serviceLedHero ? (
          <>
            <h1 class="text-xs md:text-sm tracking-wide md:tracking-widest uppercase text-white mb-4 md:mb-5 max-w-3xl leading-relaxed">
              Executive psychologist and trusted advisor to CEOs
            </h1>
            <p class="font-serif text-4xl md:text-6xl lg:text-7xl tracking-tight max-w-4xl">
              What made you successful is now holding you back
            </p>
            <p class="mt-6 text-lg md:text-2xl text-neutral-200 tracking-wide max-w-3xl">
              For CEOs and C-suite leaders in Australia
            </p>
          </>
        ) : (
          <>
            <p class="sr-only">Executive psychologist and coach for CEOs and C-suite leaders in Australia</p>
            <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl tracking-tight max-w-4xl">
              What made you successful is now holding you back
            </h1>
            <p class="mt-6 text-lg md:text-2xl text-neutral-200 tracking-wide">
              Psychologist and trusted advisor to c-suite leaders
            </p>
          </>
        )}
        <p class="mt-2 text-lg md:text-2xl text-neutral-200 tracking-wide max-w-3xl">
          I uncover the hidden derailers that traditional coaching misses
        </p>
      </div>
    </div>
  </section>

  <section class="relative">
    <SiteImage
      src={executiveCoach}
      alt="Sharon Williams, executive coach"
      class="w-full h-[50vh] md:h-[80vh] object-cover object-[70%_top]"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/75 via-neutral-950/45 to-transparent"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="max-w-7xl mx-auto px-6 w-full">
        <div class="max-w-xl md:max-w-[48%] text-left">
          <blockquote class="font-serif text-3xl md:text-5xl leading-tight italic">
            "At the top, your greatest challenge is the one you can't see."
          </blockquote>
          <a
            href="/about-sharon"
            class="inline-block mt-10 bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-8 py-3 text-sm tracking-widest uppercase transition-colors focus-ring"
          >
            About Sharon
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-neutral-950 py-24">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
      <p class="font-serif text-2xl md:text-3xl leading-relaxed">
        Perfectionism and over-functioning are brilliant assets, until they become derailers.
      </p>
      <p class="font-serif text-2xl md:text-3xl leading-relaxed text-neutral-300">
        I help you identify and remove the self-sabotaging behaviours you can't see in yourself.
      </p>
      <a href="/coaching" class="inline-block text-white text-sm tracking-widest uppercase hover:text-neutral-300 transition-colors focus-ring rounded-sm">
        Explore coaching programs &rarr;
      </a>
    </div>
  </section>

  <section class="relative" aria-hidden="true">
    <SiteImage
      src={sydneyHarbourBridge}
      alt=""
      class="w-full h-[30vh] md:h-[50vh] object-cover"
    />
    <div class="absolute inset-0 bg-neutral-950/40"></div>
  </section>

  <section class="bg-neutral-900 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid gap-10 md:gap-8 md:grid-cols-3">
        {coachingPrograms.map((program) => (
          <article class="bg-neutral-950 border border-neutral-800 p-8 flex flex-col">
            <h2 class="font-serif text-2xl md:text-3xl text-white mb-6">{program.shortTitle}</h2>
            <div class="space-y-4 text-neutral-300 flex-1">
              <p>{program.subtitle}</p>
            </div>
            <a
              href={`/coaching/${program.slug}`}
              class="inline-block mt-8 self-start bg-brand hover:bg-brand-hover text-neutral-950 font-semibold px-6 py-2.5 text-sm tracking-widest uppercase transition-colors focus-ring"
            >
              Learn More
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-neutral-950 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl mb-10 text-center">Resources</h2>
      <div class="overflow-x-auto -mx-6 px-6 pb-4">
        <div class="flex gap-6 snap-x snap-mandatory min-w-max md:min-w-0 md:grid md:grid-cols-2 lg:grid-cols-4">
          {featuredVideos.map((video) => {
            const localImage = featuredImages[video.slug];
            return (
              <a
                href={`/videos/${video.slug}`}
                class="group snap-start shrink-0 w-80 md:w-auto bg-neutral-900 border border-neutral-800 hover:border-amber-500 transition-colors flex flex-col focus-ring"
              >
                <div class="aspect-video overflow-hidden motion-safe-hover-scale">
                  {localImage ? (
                    <SiteImage
                      src={localImage}
                      alt=""
                      preset="card"
                      class="w-full h-full object-cover transition-transform duration-500"
                    />
                  ) : (
                    <img
                      src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500"
                    />
                  )}
                </div>
                <div class="p-6 flex-1 flex flex-col">
                  <h3 class="font-serif text-xl mb-4 flex-1">{video.title}</h3>
                  <span class="text-white text-sm tracking-widest uppercase">Watch video &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
      <p class="text-center mt-8">
        <a href="/videos" class="text-white text-sm tracking-widest uppercase hover:underline focus-ring rounded-sm">
          View all videos &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="bg-newsletter py-20 md:py-24" aria-labelledby="newsletter-heading">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 id="newsletter-heading" class="font-serif text-3xl md:text-5xl mb-6">
        The Psychology Behind Exceptional Leadership
      </h2>
      <p class="text-white/85 text-lg mb-10 max-w-3xl mx-auto">
        Psychological insights on leadership blind spots, derailers, and the mindset shifts that
        separate good leaders from exceptional ones.
      </p>
      <NewsletterForm />
    </div>
  </section>
</Layout>
