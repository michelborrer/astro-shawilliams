---
interface Props {
  href: string;
  match?: 'exact' | 'prefix';
  class?: string;
}

const { href, match = 'exact', class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const isActive =
  match === 'exact'
    ? pathname === href || (href !== '/' && pathname === href)
    : pathname === href || pathname.startsWith(`${href}/`);

const base =
  'text-white hover:text-brand transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand';
---

<a
  href={href}
  class:list={[base, className]}
  aria-current={isActive ? 'page' : undefined}
>
  <slot />
</a>
