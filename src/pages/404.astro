---
import Layout from '../layouts/Layout.astro';

const title = 'Page not found — Sharon Williams Psychologist';
const description = "The page you're looking for has moved or no longer exists.";
---

<Layout title={title} description={description} noindex>
  <section class="min-h-[60vh] flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-xl">
      <p class="text-amber-400 text-sm tracking-widest uppercase mb-4">404</p>
      <h1 class="font-serif text-5xl md:text-7xl mb-6">Page not found</h1>
      <p class="text-neutral-300 text-lg mb-10">
        The page you're looking for has moved or no longer exists.
      </p>
      <a
        href="/"
        class="inline-block bg-brand hover:bg-brand-hover text-white font-semibold px-8 py-3 text-sm tracking-widest uppercase transition-colors"
      >
        Back to home
      </a>
    </div>
  </section>
</Layout>
