---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  preset?: 'hero' | 'panel' | 'card' | 'avatar';
}

const presets = {
  hero: {
    widths: [640, 828, 1080, 1280, 1600],
    sizes: '100vw',
    quality: 68,
  },
  panel: {
    widths: [480, 768, 1024, 1280],
    sizes: '(min-width: 768px) 50vw, 100vw',
    quality: 70,
  },
  card: {
    widths: [320, 480, 768, 1024],
    sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 320px',
    quality: 70,
  },
  avatar: {
    widths: [320, 640],
    sizes: '320px',
    quality: 72,
  },
} as const;

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  fetchpriority,
  preset = 'hero',
} = Astro.props;

const config = presets[preset];
const widths = config.widths.filter((width) => width < src.width);
const width = Math.min(src.width, config.widths[config.widths.length - 1]);
if (!widths.includes(width)) widths.push(width);
---

<Image
  src={src}
  alt={alt}
  class={className}
  width={width}
  widths={widths}
  sizes={config.sizes}
  quality={config.quality}
  loading={loading}
  fetchpriority={fetchpriority}
/>
