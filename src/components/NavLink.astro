---
interface Props {
  href: string;
  match?: 'exact' | 'prefix';
  class?: string;
}

const { href, match = 'exact', class: className = '' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedHref = href.replace(/\/$/, '') || '/';

const isActive =
  match === 'exact'
    ? pathname === normalizedHref
    : pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`);

const base =
  'relative transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand';
const stateClass = isActive
  ? 'text-brand font-semibold after:content-[""] after:absolute after:left-0 after:right-0 after:-bottom-1.5 after:h-px after:bg-brand'
  : 'text-neutral-200 hover:text-brand';
---

<a
  href={href}
  class:list={[base, stateClass, className]}
  aria-current={isActive ? 'page' : undefined}
>
  <slot />
</a>
