---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroChess from '../assets/images/coaching-hero-chess.jpg';
import standOut from '../assets/images/coaching-stand-out.jpg';
import CoachingProgramSection from '../components/CoachingProgramSection.astro';
import { coachingPrograms, howIWork, coachingOutcomes } from '../data/coaching';

const title = 'Coaching — Sharon Williams Psychologist';
const description =
  'Executive coaching for CEOs and C-suite leaders: the Executive Deep Dive, the CEO Transition Program, and the High-Performance Team Reset — psychometric diagnostics, derailer identification, and sustained advisory.';
---

<Layout title={title} description={description} path="/coaching" schemaType="person">
  <section class="relative">
    <Image
      src={heroChess}
      alt="Chess pieces"
      class="w-full h-[60vh] md:h-[70vh] object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/20 to-neutral-950/80"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-7xl mx-auto px-6 pb-12 md:pb-16 w-full">
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl tracking-tight max-w-4xl">
          EXECUTIVE coaching
        </h1>
        <p class="mt-4 text-lg text-neutral-300 max-w-2xl">
          Psychometric diagnostics and sustained advisory for CEOs and C-suite leaders across Australia.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-neutral-900 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl mb-12 text-center">How I work</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {howIWork.map((step) => (
          <article class="bg-neutral-950 border border-neutral-800 p-8">
            <h3 class="font-serif text-2xl md:text-3xl text-amber-400 mb-4">{step.title}</h3>
            <p class="text-neutral-300 leading-relaxed">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {coachingPrograms.map((program, i) => (
    <div class={i % 2 === 0 ? 'bg-neutral-950' : 'bg-neutral-900'}>
      <CoachingProgramSection program={program} reversed={i % 2 === 1} />
    </div>
  ))}

  <section class="relative">
    <Image src={standOut} alt="Stand out from the crowd" class="w-full h-[40vh] md:h-[55vh] object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-neutral-950/40"></div>
  </section>

  <section class="bg-neutral-950 py-24">
    <div class="max-w-3xl mx-auto px-6 space-y-12">
      <h2 class="font-serif text-3xl md:text-4xl text-center">What Changes</h2>
      <blockquote class="font-serif text-2xl md:text-3xl leading-relaxed italic text-center">
        "When the diagnostic work is done, my clients don't just perform better, they lead differently."
      </blockquote>
      <ul class="space-y-4 text-neutral-300 text-lg list-disc pl-5">
        {coachingOutcomes.map((outcome) => <li>{outcome}</li>)}
      </ul>
      <blockquote class="font-serif text-2xl md:text-3xl leading-relaxed italic text-center text-amber-400">
        "This isn't about becoming a different leader, it's about removing what's in the way of the
        leader you already are."
      </blockquote>
      <p class="text-center">
        <a href="/about-sharon" class="text-amber-400 text-sm tracking-widest uppercase hover:underline focus-ring rounded-sm">
          About Sharon's credentials &rarr;
        </a>
      </p>
    </div>
  </section>
</Layout>
